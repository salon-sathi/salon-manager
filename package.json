{
  "name": "salon-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only database,auth --project salon-manager-rules-test \"vitest run --config vitest.rules.config.js\"",
    "test:e2e": "firebase emulators:exec --only auth,database,storage --project salon-manager-49a88 \"playwright test\"",
    "test:e2e:ui": "firebase emulators:exec --only auth,database,storage --project salon-manager-49a88 \"playwright test --ui\"",
    "test:e2e:headed": "firebase emulators:exec --only auth,database,storage --project salon-manager-49a88 \"playwright test --headed\"",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "firebase": "^12.14.0",
    "jsbarcode": "^3.12.3",
    "pdfjs-dist": "^6.0.227",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "firebase-tools": "^15.25.1",
    "globals": "^15.14.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "vite": "^5.4.11",
    "vitest": "^4.1.9"
  }
}
