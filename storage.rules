rules_version = '2';

// ============================================================================
//  ⚠⚠⚠  DEPLOY WILL NOT WORK UNTIL YOU EDIT THIS  ⚠⚠⚠
//
//  The owner allowlist below still contains the literal placeholder
//  'OWNER_EMAIL_1'. Deployed as-is, NOBODY matches it, so every vendor-bill
//  proof upload and every attempt to open one fails with
//  storage/unauthorized — which presents in the app as "Upload failed",
//  not as "you forgot to edit a rules file".
//
//  1. Replace 'OWNER_EMAIL_1' in isOwner() below with the owner's SIGN-IN
//     EMAIL. Two owners? Add the second: ['a@x.com', 'b@x.com'].
//  2. Deploy:
//         firebase deploy --only storage
//     (or both rule files at once:  firebase deploy --only database,storage)
//  3. Sign in as that owner and attach a proof to a vendor bill to confirm.
//
//  Nothing else in this file needs an email. Customer receipts and the
//  catch-all deny below are role-free.
// ============================================================================
//
// Firebase Storage holds vendor-bill proof files under shop/bills/<billId>/<file>
// (see src/lib/bills.js). The Firebase config is public, so these rules are the gate.
//
// WHY THIS FILE STILL USES AN EMAIL, WHEN THE DATABASE USES ROLES
// ----------------------------------------------------------------------------
// Storage rules cannot read the Realtime Database. There is a `firestore.get()`
// cross-service call, but no RTDB equivalent, so the shop/users/<uid>/role lookup
// that database.rules.json performs is simply not expressible here. The honest
// options are an email allowlist or custom auth claims (which need a backend /
// Admin SDK — out of scope for this app).
//
// Vendor bills are owner-only anyway, so an email allowlist costs nothing in
// practice: the set of people allowed to touch proofs is exactly {the owner}.
service firebase.storage {
  match /b/{bucket}/o {
    // ---- THE OWNER ALLOWLIST — the one line you must edit ------------------
    // This is the whole configuration surface of this file. Every rule that
    // needs "is this the owner?" calls isOwner(); no email appears anywhere
    // else, so there is exactly one place to get wrong.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email in ['OWNER_EMAIL_1'];
    }

    // Vendor-bill proofs: owner-only, and capped at 10 MB to match MAX_PROOF_BYTES.
    match /shop/bills/{billId}/{fileName} {
      allow read: if isOwner();
      allow write: if isOwner()
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Customer receipt images: the bill a customer is sent on WhatsApp (src/lib/receipts.js).
    //
    // READ IS PUBLIC, AND HAS TO BE. The customer tapping the link in WhatsApp is not signed
    // in and never will be — there is no customer login in this app. What actually protects a
    // receipt is that its URL is unguessable: Firebase mints a random download token per
    // object, and the path is keyed on the SALE ID with the customer's phone number
    // deliberately kept out of it. Somebody holding a link sees that one bill; nobody can
    // enumerate or guess a second one.
    //
    // Writing is staff-only (any signed-in user, NOT the owner allowlist used for vendor
    // bills above — deliberately not isOwner()): a biller who can ring up a sale and print it
    // must also be able to send the customer their copy. Capped at 2 MB — a 72mm receipt JPEG
    // is ~20-60 KB, so anything near the cap is a bug or an upload that isn't a receipt.
    match /shop/receipts/{saleId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
    }

    // Everything else is denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
