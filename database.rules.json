{
  "rules": {
    // ========================================================================
    // Salon Manager — role-based Realtime Database rules.
    //
    // The Firebase config in src/lib/firebase.js is public by design, so these
    // rules are the real access gate. src/lib/roles.js mirrors this matrix in
    // the UI; the two MUST be kept in step. The UI decides what renders, these
    // rules decide what is actually readable and writable.
    //
    // Roles live at shop/users/<uid>/role and are one of: owner | biller |
    // inventory. A user with active === false has no access at all.
    //
    // SETUP:
    //   1. Deploy:  firebase deploy --only database
    //   2. Sign in with the owner's account FIRST. While shop/users is empty,
    //      the first authenticated user self-registers as owner (see the
    //      bootstrap rule below), after which this node locks down and only an
    //      owner can add users (from Settings → Users in the app).
    //   (Firebase RTDB rules allow these // comments; they're stripped on deploy.)
    //
    // There is no OWNER_EMAIL placeholder to edit any more — ownership is
    // claimed by that first sign-in, not hard-coded.
    //
    // Reading these rules: RTDB has no functions, so the role lookup
    //   root.child('shop/users').child(auth.uid)...
    // is spelled out in full on every node. The repeated shapes are:
    //   active user →  .../active === true
    //   owner       →  .../role === 'owner' && .../active === true
    //   stock duty  →  .../role in ('owner','inventory') && .../active === true
    // ========================================================================

    // Nothing outside shop/ is readable or writable.
    ".read": false,
    ".write": false,

    "shop": {
      // ---- users: the role registry itself --------------------------------
      "users": {
        // Readable by any active user (the app needs names/roles to render the
        // Users screen). While the node is EMPTY, any authenticated user may
        // read it — otherwise the very first owner could never discover that
        // the shop is un-claimed, and bootstrap would deadlock. An empty node
        // leaks nothing.
        ".read": "auth != null && (!data.exists() || root.child('shop/users').child(auth.uid).child('active').val() === true)",

        "$uid": {
          // Always let a user read their OWN record, even when they have none
          // yet. Without this, a signed-in user with no role could not learn
          // that they have no role, and the app could not sign them out with a
          // clear message.
          ".read": "auth != null && $uid === auth.uid",

          // Two ways to write:
          //  1. BOOTSTRAP — shop/users is empty and you are claiming your own
          //     uid as an active owner. This is how the shop gets its first
          //     owner without a Firebase console visit.
          //  2. An existing active owner managing anyone.
          ".write": "auth != null && ((!root.child('shop/users').exists() && $uid === auth.uid && newData.child('role').val() === 'owner' && newData.child('active').val() === true) || (root.child('shop/users').child(auth.uid).child('role').val() === 'owner' && root.child('shop/users').child(auth.uid).child('active').val() === true))",

          // Deletes are allowed (newData won't exist); otherwise a record must
          // be well-formed. Deactivating is preferred over deleting, so that
          // past activity keeps resolving to a name.
          ".validate": "!newData.exists() || newData.hasChildren(['email', 'role', 'active'])",

          "role": { ".validate": "newData.isString() && (newData.val() === 'owner' || newData.val() === 'biller' || newData.val() === 'inventory')" },
          "email": { ".validate": "newData.isString() && newData.val().length > 3" },
          "active": { ".validate": "newData.isBoolean()" },
          "name": { ".validate": "newData.isString()" },
          "createdAt": { ".validate": "newData.isString() || newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },

      // ---- config: shop identity + loyaltyConfig (a singleton) ------------
      // Everyone needs to READ it (the receipt, the branding, the loyalty
      // earn/redeem rates used at billing). Only the owner may change it.
      "config": {
        ".read": "auth != null && root.child('shop/users').child(auth.uid).child('active').val() === true",
        ".write": "auth != null && root.child('shop/users').child(auth.uid).child('role').val() === 'owner' && root.child('shop/users').child(auth.uid).child('active').val() === true"
      },

      // ---- items: retail + backbar stock ----------------------------------
      // Read by all (billing sells products). Written by owner + inventory.
      "items": {
        ".read": "auth != null && root.child('shop/users').child(auth.uid).child('active').val() === true",
        ".write": "auth != null && root.child('shop/users').child(auth.uid).child('active').val() === true && (root.child('shop/users').child(auth.uid).child('role').val() === 'owner' || root.child('shop/users').child(auth.uid).child('role').val() === 'inventory')"
      },

      // ---- sales: bills ----------------------------------------------------
      // Every active role reads and CREATES bills — that is the POS. Changing
      // or deleting one afterwards is an owner action:
      //   !data.exists() && newData.exists()  → a create (any active user)
      //   data.exists()                       → an edit or a delete (owner)
      //
      // WHY: a bill is the shop's record of what was taken. A biller who can
      // rewrite one after the fact can move money off the books — re-ring a
      // ₹2000 bill as ₹200 an hour later, or overwrite a sale somebody else
      // rang up — and nothing downstream would show it, because every figure
      // in the app (revenue, commission, points, package sessions) is DERIVED
      // from the bills. The README's role table has always listed editing and
      // deleting a bill as the owner's; this used to enforce only the delete
      // half, because `newData.exists()` alone cannot tell a create from an
      // edit. Adding `!data.exists()` is what closes it.
      //
      // NOTE: workers can still READ sales because the POS cannot work
      // otherwise. See the README — a known and accepted limit of the design.
      //
      // The .validate below is the record's shape. It is written to hold for
      // FIELD-LEVEL updates too: src/lib/sync.js pushes deltas (buildSliceUpdate
      // writes `<id>/<field>` paths, and only writes a whole record when the
      // record is new), and RTDB validates the RESULTING node — `newData` at
      // $id is the merge of the write with what is already stored — so a
      // one-field update of an existing, well-formed bill still satisfies
      // hasChildren. Ancestor .validate rules ARE evaluated on a child write,
      // which is exactly what makes that work. A delete writes null, and
      // .validate never runs on a node that is being removed, hence the
      // `!newData.exists() ||` guard.
      "sales": {
        ".read": "auth != null && root.child('shop/users').child(auth.uid).child('active').val() === true",
        "$id": {
          ".write": "auth != null && root.child('shop/users').child(auth.uid).child('active').val() === true && ((!data.exists() && newData.exists()) || root.child('shop/users').child(auth.uid).child('role').val() === 'owner')",
          ".validate": "!newData.exists() || newData.hasChildren(['id', 'date', 'total', 'lines'])",

          "id": { ".validate": "newData.isString()" },
          // Local date, never a timestamp — the whole app bills in the salon's
          // own day. YYYY-MM-DD is what todayStr() and every date input produce.
          "date": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" },
          // Paise-rounded rupees. A string here would still add up in JS and
          // silently corrupt every total downstream.
          "total": { ".validate": "newData.isNumber()" }
        }
      },

      // ---- appointments -----------------------------------------------------
      // The diary is shared: every active role books, reschedules and closes
      // appointments. Deletes are allowed too — a cancellation is a status
      // change, but removing a mis-typed slot is routine front-desk work.
      "appointments": {
        ".read": "auth != null && root.child('shop/users').child(auth.uid).child('active').val() === true",
        ".write": "auth != null && root.child('shop/users').child(auth.uid).child('active').val() === true"
      },

      // ---- publicBookings: the customer's inbox ----------------------------
      // The ONLY node an unauthenticated client may write, anywhere in this
      // file. Create-only, one record at a time, strictly shaped, and NOT
      // readable without a staff account — it holds a name and a phone number.
      //
      // Staff read it and delete it. The importer in the shell moves each entry
      // into shop/appointments in ONE atomic fan-out (appointment written, inbox
      // entry nulled), so an entry that is gone has been imported. The
      // appointment takes the INBOX ID and derives every other field, which is
      // what makes that safe: two devices draining the same entry at the same
      // moment write identical records, and a booking the salon later deletes
      // can never be resurrected, because the entry that would resurrect it went
      // in the same update as the appointment.
      //
      // WHY A SEPARATE NODE, and not a create-only rule on shop/appointments:
      // .write rules CASCADE and only ever GRANT. The appointments slice already
      // grants write to every active user, so a $id rule there could not
      // restrict staff — it could only add the public branch, leaving .validate
      // as the sole constraint. But .validate applies to every writer, so each
      // field rule would need an `auth != null ||` escape hatch: a dozen
      // dual-purpose expressions guarding the busiest node in the app, where
      // forgetting one hatch breaks the counter mid-shift and forgetting one
      // clause hands a signed-in stranger an unvalidated write into the live
      // diary. Here every .validate below means exactly one thing.
      //
      // The kill switch is shop/public/profile/enabled. Rules read the datastore
      // with full privileges regardless of .read (same as the shop/users lookups
      // above), and the booking page reads that SAME value — so "the button is
      // hidden" and "the write is refused" can never disagree. A missing value
      // is `null === true` → false: this fails CLOSED.
      "publicBookings": {
        ".read": "auth != null && root.child('shop/users').child(auth.uid).child('active').val() === true",

        "$id": {
          // Second branch deliberately does NOT test `auth == null`. A customer
          // carrying a stale Firebase session from some other visit is still a
          // customer, and there is no asymmetry to exploit: every .validate here
          // applies unconditionally, to staff and public alike.
          ".write": "(auth != null && root.child('shop/users').child(auth.uid).child('active').val() === true) || (!data.exists() && newData.exists() && root.child('shop/public/profile/enabled').val() === true)",

          // A delete writes null, and .validate never runs on a node being
          // removed — hence the guard, same idiom as sales and customers above.
          ".validate": "!newData.exists() || (newData.hasChildren(['id', 'date', 'startMin', 'durationMin', 'serviceIds', 'customerName', 'customerPhone', 'createdAtMs']) && newData.child('id').val() === $id)",

          "id": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
          "date": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" },
          "startMin": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1440" },
          "durationMin": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 480" },
          // RTDB stores an empty array as null, so the key vanishes and the
          // hasChildren above already refuses it. $i caps the basket at ten.
          "serviceIds": {
            ".validate": "newData.hasChildren()",
            "$i": { ".validate": "$i.matches(/^\\d$/) && newData.isString() && newData.val().length > 0 && newData.val().length <= 40" }
          },
          "customerName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
          // The same shape customers.js enforces at the counter (isValidPhone).
          "customerPhone": { ".validate": "newData.isString() && newData.val().matches(/^[6-9]\\d{9}$/)" },
          "note": { ".validate": "newData.isString() && newData.val().length <= 200" },
          // ServerValue.TIMESTAMP, pinned. NOT Date.now(): a budget phone ten
          // minutes out of step would fail any tolerance window and lose the
          // booking, and a far-future value would make its slot stub unprunable.
          "createdAtMs": { ".validate": "newData.isNumber() && newData.val() === now" },
          "$other": { ".validate": false }
        }
      },

      // ---- public: the only unauthenticated READ surface --------------------
      // A projection, rebuilt from config + services + staff + appointments by
      // the devices that already own those. Nothing under here carries a name, a
      // phone other than the shop's own, or what anybody paid — a stylist
      // appears as a bare id and nothing else, because the booking page has to
      // know a chair is free without learning whose it is.
      //
      // Each part is writable by whoever can write what it is derived FROM:
      // profile/services/chairs come from owner-only nodes, so owner-only;
      // slots come from the diary, so any active user keeps them fresh.
      "public": {
        ".read": true,

        "profile": {
          ".write": "auth != null && root.child('shop/users').child(auth.uid).child('role').val() === 'owner' && root.child('shop/users').child(auth.uid).child('active').val() === true",
          ".validate": "!newData.exists() || newData.hasChildren(['name', 'enabled'])",
          "enabled": { ".validate": "newData.isBoolean()" }
        },

        "services": {
          ".write": "auth != null && root.child('shop/users').child(auth.uid).child('role').val() === 'owner' && root.child('shop/users').child(auth.uid).child('active').val() === true"
        },

        "chairs": {
          ".write": "auth != null && root.child('shop/users').child(auth.uid).child('role').val() === 'owner' && root.child('shop/users').child(auth.uid).child('active').val() === true"
        },

        // Occupancy stubs, by day then by booking id: when a chair is busy and
        // whether that is a customer or blocked-out time. No id, no name, no
        // service. The customer writes theirs in the same atomic fan-out as the
        // booking, so the page cannot offer a slot that a booking no staff
        // device has seen yet already holds. Staff write and prune the rest.
        "slots": {
          // Staff are granted here, at the top of the subtree, rather than per
          // record: the reconcile also drops whole past days (a null at $date),
          // which a grant that only reached $id would refuse. .write cascades
          // and only ever grants, so the public branch below still stands on its
          // own — and .validate applies to both writers either way, which is
          // what keeps one shape for the salon and the street.
          ".write": "auth != null && root.child('shop/users').child(auth.uid).child('active').val() === true",

          "$date": {
            "$id": {
              ".write": "!data.exists() && newData.exists() && root.child('shop/public/profile/enabled').val() === true",
              ".validate": "!newData.exists() || ($date.matches(/^\\d{4}-\\d{2}-\\d{2}$/) && newData.hasChildren(['startMin', 'durationMin', 'createdAtMs']))",

              "staffId": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "startMin": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 1440" },
              "durationMin": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 480" },
              "kind": { ".validate": "newData.isString() && (newData.val() === 'appt' || newData.val() === 'block')" },
              "createdAtMs": { ".validate": "newData.isNumber() && newData.val() === now" },
              "$other": { ".validate": false }
            }
          }
        }
      },

      // ---- customers --------------------------------------------------------
      // Billing must look customers up and quick-create them, so every active
      // role can read and write this slice. RTDB rules are per-node, so we
      // cannot grant "create but don't browse" here — the browse restriction is
      // a UI control only (roles.js: customers.pick vs customers.browse).
      // Documented in the README.
      //
      // The shape is validated per record, on the same terms as sales above: a
      // customer is keyed by phone and `id` IS that phone (blankCustomer sets
      // both), so a record without one cannot be found again by anything. The
      // name is what every reminder, receipt and search result renders, and a
      // blank one turns the customer list into a column of empty rows — the UI
      // already refuses it (validateCustomer), this makes it true of the
      // database as well. Partial updates keep passing for the same reason
      // they do on sales: the reconcilers push single fields (totalVisits,
      // loyaltyPoints, …) onto records that already carry id and name, and
      // `newData` at $id is the merged result, not just the delta.
      "customers": {
        ".read": "auth != null && root.child('shop/users').child(auth.uid).child('active').val() === true",
        ".write": "auth != null && root.child('shop/users').child(auth.uid).child('active').val() === true",
        "$id": {
          ".validate": "!newData.exists() || newData.hasChildren(['id', 'name'])",

          "id": { ".validate": "newData.isString()" },
          "name": { ".validate": "newData.isString() && newData.val().length > 0" }
        }
      },

      // ---- the salon catalogue: read-only for workers -----------------------
      // Prices, commission rates and package definitions are owner decisions.
      // Workers read them to bill; they cannot edit them.
      "services": {
        ".read": "auth != null && root.child('shop/users').child(auth.uid).child('active').val() === true",
        ".write": "auth != null && root.child('shop/users').child(auth.uid).child('role').val() === 'owner' && root.child('shop/users').child(auth.uid).child('active').val() === true"
      },
      "staff": {
        ".read": "auth != null && root.child('shop/users').child(auth.uid).child('active').val() === true",
        ".write": "auth != null && root.child('shop/users').child(auth.uid).child('role').val() === 'owner' && root.child('shop/users').child(auth.uid).child('active').val() === true"
      },
      "packages": {
        ".read": "auth != null && root.child('shop/users').child(auth.uid).child('active').val() === true",
        ".write": "auth != null && root.child('shop/users').child(auth.uid).child('role').val() === 'owner' && root.child('shop/users').child(auth.uid).child('active').val() === true"
      },
      "messageTemplates": {
        ".read": "auth != null && root.child('shop/users').child(auth.uid).child('active').val() === true",
        ".write": "auth != null && root.child('shop/users').child(auth.uid).child('role').val() === 'owner' && root.child('shop/users').child(auth.uid).child('active').val() === true"
      },

      // ---- customerPackages -------------------------------------------------
      // A sold package is redeemed AT the counter, which decrements usesLeft —
      // so this has to be writable by whoever is billing.
      "customerPackages": {
        ".read": "auth != null && root.child('shop/users').child(auth.uid).child('active').val() === true",
        ".write": "auth != null && root.child('shop/users').child(auth.uid).child('active').val() === true"
      },

      // ---- logs: the activity trail -----------------------------------------
      // Every role WRITES here (that is the point of an audit trail) and every
      // role can read, because the sync engine has to read a slice once before
      // it can push deltas to it — a write-only slice would silently never
      // record worker activity. Logs expose no more than sales already do.
      // The Logs VIEW is still owner-only (roles.js: logs.view).
      "logs": {
        ".read": "auth != null && root.child('shop/users').child(auth.uid).child('active').val() === true",
        ".write": "auth != null && root.child('shop/users').child(auth.uid).child('active').val() === true"
      },

      // ---- the money slices: owner-only, read AND write ----------------------
      // These are the genuinely sensitive nodes, and unlike sales the app has no
      // operational reason to read them at the counter. The client only
      // subscribes to these when the signed-in user is an owner, so a worker
      // never trips a permission-denied here.
      "expenses": {
        ".read": "auth != null && root.child('shop/users').child(auth.uid).child('role').val() === 'owner' && root.child('shop/users').child(auth.uid).child('active').val() === true",
        ".write": "auth != null && root.child('shop/users').child(auth.uid).child('role').val() === 'owner' && root.child('shop/users').child(auth.uid).child('active').val() === true"
      },
      "vendorBills": {
        ".read": "auth != null && root.child('shop/users').child(auth.uid).child('role').val() === 'owner' && root.child('shop/users').child(auth.uid).child('active').val() === true",
        ".write": "auth != null && root.child('shop/users').child(auth.uid).child('role').val() === 'owner' && root.child('shop/users').child(auth.uid).child('active').val() === true"
      },
      "dailyBills": {
        ".read": "auth != null && root.child('shop/users').child(auth.uid).child('role').val() === 'owner' && root.child('shop/users').child(auth.uid).child('active').val() === true",
        ".write": "auth != null && root.child('shop/users').child(auth.uid).child('role').val() === 'owner' && root.child('shop/users').child(auth.uid).child('active').val() === true"
      },

      // Any slice not named above stays denied by the root rules.
      "$other": {
        ".read": false,
        ".write": false
      }
    }
  }
}
